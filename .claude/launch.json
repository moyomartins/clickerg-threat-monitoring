{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "clickerg",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5180"
      ],
      "port": 5180,
      "autoPort": true
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "storybook",
        "--",
        "--no-open",
        "--port",
        "6007"
      ],
      "port": 6007,
      "autoPort": false
    },
    {
      "name": "previews",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "previews",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199
    }
  ]
}